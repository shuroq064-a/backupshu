# --- Local dev (default for all interns). Requires: docker compose -f ../docker-compose.local.yml up -d
# NOTE: no sslmode here — local Postgres has no SSL. Shared/prod DB uses ?sslmode=require.
DATABASE_URL=postgresql://shuroqx:shuroqx_dev@localhost:5432/shuroqx
JWT_SECRET=dev-only-change-me-in-prod
REDIS_URL=redis://localhost:6379/0
# Optional. If empty, Celery uses REDIS_URL for both broker and result backend.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
OLA_MAPS_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay (test keys — ask lead, or leave blank if not testing payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Primary LLM (OpenAI-compatible)
PRIMARY_API_KEY=
PRIMARY_BASE_URL=https://api.mistral.ai/v1
PRIMARY_MODEL=mistral-medium-3-5

# Fallback LLM (Gemini)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta
FALLBACK_MODEL=gemma-3-27b-it
FALLBACK_TIMEOUT=15

ENVIRONMENT=development

# Groq (Voice STT, optional for local)
GROQ_API_KEY=
